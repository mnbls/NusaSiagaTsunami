rules_version = '2';

// Aturan keamanan Cloud Firestore untuk Nusa Siaga.
// Salin seluruh isi berkas ini ke Firebase Console > Firestore Database > Rules, lalu tekan Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Progres pribadi: hanya pemilik akun yang bisa membaca dan menulis.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Papan peringkat: semua orang boleh membaca (termasuk tamu),
    // tetapi hanya pemilik akun yang boleh menulis barisnya sendiri, dengan isi yang dibatasi.
    match /leaderboard/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'cls', 'stars', 'done', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.cls is string && request.resource.data.cls.size() <= 20
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 300
        && request.resource.data.done is int && request.resource.data.done >= 0 && request.resource.data.done <= 100
        && request.resource.data.updatedAt == request.time;
    }
  }
}
